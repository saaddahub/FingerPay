# ============================================================
# FingerPay environment. Never commit a filled-in copy.
# Local dev: don't fill this by hand; run `npx supabase start` then `npm run dev:setup`,
#   which writes .env.local for the local stack.
# Staging (hosted Supabase): copy to .env.staging.local and fill in.
# See docs/SPEC.md §4.8 for what each value protects.
# ============================================================

# Supabase (Settings → API). Used for staff login only; the anon key cannot reach schema fp.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Least-privilege app role via the Supavisor transaction pooler (port 6543), TLS verified:
# postgresql://fp_app.<project-ref>:<password>@<pooler-host>:6543/postgres
FP_DATABASE_URL=
# PEM of Supabase's root CA (Dashboard → Database → SSL). Required for any non-local database.
FP_DATABASE_CA=

# Encryption keyring (rotatable) and lookup key (long-lived). Generate each 32-byte key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FP_KEYRING={"active":1,"keys":{"1":""}}
FP_LOOKUP_KEY=

# development | staging | production
FP_ENV=development

# Demo deployments only. The app refuses demo mode when FP_ENV=production.
FP_DEMO_MODE=false
FP_DEMO_KEY=
FP_DEMO_OBSERVER_ID=

# LOCAL ONLY, seed/admin scripts (npm run seed:demo). Never add these to Vercel: the app refuses
# to start outside development when either is set.
SUPABASE_SERVICE_ROLE_KEY=
# Owner (postgres) login for the seed's ledger funding: postgresql://postgres.<ref>:<pw>@<pooler-host>:5432/postgres
FP_SEED_DATABASE_URL=
