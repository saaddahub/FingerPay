# ==============================================================================
# FingerPay Environment Configuration (.env.example)
# Copy to .env.local (never commit real secrets).
# ==============================================================================

# Environment: development | test | staging | production
# Note: FP_DEMO_MODE=true is rejected at startup if FP_ENV=production (SPEC T22).
FP_ENV=development
FP_HOST=0.0.0.0
FP_PORT=4000
FP_LOG_LEVEL=info
FP_DEMO_MODE=true

# Comma-separated Origin allowlist for state-changing POST requests (SPEC §4.6)
FP_ALLOWED_ORIGINS=http://localhost:3000

# Runtime database connection (least-privilege fp_app role)
FP_DATABASE_URL=postgresql://fp_app:app-dev-only-password@127.0.0.1:5432/fingerpay
FP_DB_POOL_MAX=20

# Migration connection (fp_owner role — used only by `pnpm db:migrate`)
FP_MIGRATE_DATABASE_URL=postgresql://fp_owner:owner-dev-only-password@127.0.0.1:5432/fingerpay

# Worker connection (fp_worker role — used by `main.worker.ts`)
FP_WORKER_DATABASE_URL=postgresql://fp_worker:worker-dev-only-password@127.0.0.1:5432/fingerpay

# Frontend -> Backend internal rewrite origin
FP_API_ORIGIN=http://127.0.0.1:4000

# Cryptography keys (M1+): 32-byte base64 strings generated via `openssl rand -base64 32`
FP_KEYRING={"active":1,"keys":{"1":"REPLACE_WITH_32_BYTE_BASE64_KEY"}}
FP_LOOKUP_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
FP_DEMO_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Supabase (SPEC §2, §4.7)
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
