{
  "name": "@fingerpay/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude ../.demo-credentials.local.md src/main.api.ts",
    "dev:worker": "tsx watch src/main.worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "db:migrate": "tsx src/scripts/migrate.ts up",
    "db:rollback": "tsx src/scripts/migrate.ts down",
    "db:status": "tsx src/scripts/migrate.ts status",
    "db:bootstrap:supabase": "tsx src/scripts/bootstrap-supabase.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir test/unit",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:security": "vitest run --dir test/security"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fingerpay/contracts": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@supabase/supabase-js": "^2.49.1",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.0.8",
    "kysely": "^0.27.5",
    "otpauth": "^9.3.6",
    "pg": "^8.13.3",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fingerpay/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
